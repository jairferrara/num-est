% Tema Beamer UNAM (Universidad Nacional Autónoma de México).
% Adaptado del tema UNAM de Alexandru Fikl (https://github.com/alexfikl/unam-beamer, v0.4),
% con logos, colores y nombres de la UNAM.
%
% Uso:
%   \usetheme[opciones]{unam}

\def\fileversion{v1.0}
\def\filedate{2026/11/18}

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthemeunam}[\filedate \fileversion UNAM Beamer Theme]

% <<< options

\RequirePackage{ifthen}
\RequirePackage{kvoptions}
\SetupKeyvalOptions{
    family=unam,
    prefix=unam@
}

% desactiva Myriad Pro (usa Helvetica)
\DeclareBoolOption[false]{nomyriadpro}
% show progressbar in the footer
\DeclareBoolOption[false]{progressbar}
% show a debug layout grid
\DeclareBoolOption[false]{showframe}
\DeclareBoolOption[false]{layoutgrid}

\ProcessOptionsBeamer
\DeclareDefaultOption{\PackageWarning{beamerthemeunam}{Unknown option `\CurrentOption`}}
\ProcessKeyvalOptions*

% >>>

% <<< packages

\RequirePackage{ifpdf}
\RequirePackage{relsize}

% fancy graphics
\RequirePackage{tikz}

% nicer command definitions
\RequirePackage{xparse}
% used in defining blocks
\RequirePackage{adjustbox}
\RequirePackage{colortbl}

\ifunam@showframe
    \RequirePackage{showframe}
\fi

\ifunam@layoutgrid
    \RequirePackage[
        grid,
        gridunit=cm,
        gridcolor=gray!70,
        subgridcolor=gray!70,
        texcoord]{eso-pic}
\fi

\usecolortheme{unam}

% >>>

% <<< commands

\ProvideDocumentCommand \unamheaderlogo { m } {\def\unam@headerlogo{#1}}
\ProvideDocumentCommand \unammotto { m } {\def\unam@motto{#1}}
\ProvideDocumentCommand \unamtitlelogo { m } {\def\unam@titlelogo{#1}}
\ProvideDocumentCommand \unamslidelogo { m } {\def\unam@slidelogo{#1}}
\ProvideDocumentCommand \unamtitlelogoshift { m } {\def\unam@titlelogoshift{#1}}
\ProvideDocumentCommand \unamurl { m m } {\def\unam@url{#1}\def\unam@urltext{#2}}

\ProvideDocumentCommand \venue { m } {\def\unam@venue{#1}}

% >>>

% <<< assets

\unamheaderlogo{\includegraphics[width=0.2\paperwidth]{assets/unam-logo}}
\unammotto{}
\unamtitlelogo{\includegraphics[width=0.45\paperheight]{assets/unam-escudo-gris}}
\unamslidelogo{\includegraphics[width=0.45\paperheight]{assets/unam-escudo-gris}}
\unamtitlelogoshift{-0.7cm}
\unamurl{https://www.unam.mx}{www.unam.mx}
\def\unam@mottospacing{\hspace{0.75\beamer@rightmargin}\vspace*{-7.5pt}}

% >>>

% <<< fonts

\ifpdftex
    \RequirePackage[utf8]{inputenc}
    \RequirePackage[T1]{fontenc}
\else
    \RequirePackage{fontspec}
\fi

\ifunam@nomyriadpro
    \usepackage{helvet}
\else
    \ifpdftex
        \IfFileExists{MyriadPro.sty}{
            \usepackage[onlytext, smallfamily, lf]{MyriadPro}
        }{
            \PackageWarning{beamerthemeunam}{Myriad Pro font is not available to pdfLaTeX. Use the nomyriadpro option to silence this warning.}
            \usepackage{helvet}}
    \else
        \IfFontExistsTF{Myriad Pro}{
            \setmainfont{Myriad Pro}
            \setsansfont{Myriad Pro}
        }{
            \PackageWarning{beamerthemeunam}{Myriad Pro font is not available. Use the nomyriadpro option to silence this warning.}
            \usepackage{helvet}}
    \fi
\fi
\renewcommand{\familydefault}{\sfdefault}

\setbeamerfont{title}        {size=\LARGE, series=\bfseries}
\setbeamerfont*{subtitle}    {size=\large, series=\mdseries}
\setbeamerfont{author}       {size=\normalsize, series=\bfseries}
\setbeamerfont{date}         {size=\small, series=\mdseries}
\setbeamerfont{venue}        {size=\small, series=\mdseries}

\setbeamerfont{frametitle}   {size=\LARGE, series=\bfseries}
\setbeamerfont{framesubtitle}{size=\normalsize, series=\mdseries}

\setbeamerfont{section title}{size=\LARGE,series=\bfseries}

\setbeamerfont{alerted text} {series=\bfseries}
\setbeamerfont{block title}{size=\relsize{+1},series=\bfseries}
\setbeamerfont{block title alerted}{size=\relsize{+1},series=\bfseries}

\setbeamerfont{page number in head/foot}{size=\tiny, series=\bfseries}
\setbeamerfont{url text}{size=\scriptsize,series=\bfseries}
\setbeamerfont{author in head/foot}{size=\scriptsize,series=\bfseries}

\setbeamerfont{enumerate item}{size={}, series=\bfseries}
\setbeamerfont{description item}{size={}, series=\bfseries}

\setbeamerfont{itemize/enumerate body}{size={}}
\setbeamerfont{itemize/enumerate subbody}{size={}}
\setbeamerfont{itemize/enumerate subsubbody}{size={}}

% >>>

% <<< outer: header / footer

\defbeamertemplate*{frametitle}{unamframe}{
    \vspace{-18pt}
    \begin{beamercolorbox}[wd=\paperwidth, leftskip=0.05\paperwidth]{frametitle}
        \ifx\insertframesubtitle\empty
        {\vspace{10pt}\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}
        \else
        {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}\\[-7pt]
        {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle}
        \fi
    \end{beamercolorbox}
}

\defbeamertemplate*{headline}{unamframe}{
    \begin{tikzpicture}[remember picture, overlay]
    \fill[UNAMDarkBlue, anchor=west] (0, -0.39) rectangle (0.1, 1.6\beamer@rightmargin);
    \end{tikzpicture}%
    \vspace{0pt}
    \hfill
    \unam@headerlogo
    \hspace{\beamer@rightmargin}
}

\newlength{\unam@progressbarwidth}
\defbeamertemplate{footline}{unamframe}{
    \vspace{5pt}
    \ifunam@progressbar
    % tope: en la 1.ª pasada el total aún no se conoce y la barra se pasaría del máximo de TeX
    \ifnum\inserttotalframenumber<\insertframenumber\relax
        \unam@progressbarwidth=\paperwidth
    \else
        \unam@progressbarwidth=\dimexpr\paperwidth*\insertframenumber/\inserttotalframenumber\relax
    \fi
    \begin{tikzpicture}[remember picture, overlay]
    \fill[UNAMGold, anchor=west]
        (0, -0.3ex) rectangle (\unam@progressbarwidth, 0ex);
    \end{tikzpicture}%
    \fi
    \begin{beamercolorbox}[wd=\textwidth, ht=2.5ex]{footline hline}%
    \hfill \unam@motto
    \unam@mottospacing

    \hspace{\beamer@leftmargin}%
    \usebeamerfont{author in head/foot}\insertshortauthor%
    \hfill\usebeamercolor[fg]{url text}\usebeamerfont{url text}%
    \href{\unam@url}{\unam@urltext}%
    \hspace{1.75\beamer@rightmargin}
    \vspace*{0.75pt}
    \end{beamercolorbox}
    \begin{beamercolorbox}[wd=\textwidth, sep=5pt]{footline}%
        \centering
        \usebeamertemplate*{frame footer}
        \usebeamercolor[fg]{page number in head/foot}
        \usebeamerfont{page number in head/foot}
        \insertframenumber~/~\inserttotalframenumber
    \end{beamercolorbox}
}
\setbeamertemplate{footline}[unamframe]

% >>>

% <<< inner: environments

% <<< templates

\setbeamertemplate{background}[unamslide]

% \titleframe[<extra>]: <extra> se dibuja encima de la portada (p.ej. un \postit)
\NewDocumentCommand \titleframe {O{}} {
    \setbeamertemplate{title page}[unamtitlepage]
    \setbeamertemplate{background}[unamtitlepage]
    \frame[plain,noframenumbering]{\titlepage#1}
    \setbeamertemplate{background}[unamslide]
}

\NewDocumentCommand \sectionframe {} {
    \setbeamertemplate{section page}[unamsectionpage]
    \setbeamertemplate{background}[unamtitlepage]
    \frame[plain,noframenumbering]{\sectionpage}
    \setbeamertemplate{background}[unamslide]
}
\AtBeginSection{
    \sectionframe
}

% >>>

% <<< title page

\defbeamertemplate{title page}{unamtitlepage}
{
    \vspace{0.55\paperheight}
    \begin{center}
        % title format
        \usebeamerfont{title}\usebeamercolor[fg]{title}
        \inserttitle\par
        % subtitle
        \usebeamerfont{subtitle}\insertsubtitle\par%
        \bigskip
        % author
        \usebeamerfont{author}\insertauthor\par%
        \usebeamerfont{date}\insertdate%
        \@ifundefined{unam@venue}{}{\par\usebeamerfont{venue}\unam@venue}
    \end{center}
}

\defbeamertemplate{section page}{unamsectionpage}
{
    \vspace{0.55\paperheight}
    \begin{center}
        \begin{minipage}[t][][c]{\textwidth}%
            \centering
            \usebeamerfont{section title}\usebeamercolor[fg]{section title}
            \insertsectionhead\par
        \end{minipage}
    \end{center}
    \vfill
}

% >>>

% <<< background

\defbeamertemplate{background}{unamtitlepage}
{
    \begin{tikzpicture}[remember picture, overlay]
        \node [shading=axis,
               rectangle,
               left color=UNAMDarkBlue,
               right color=UNAMLightBlue!70,
               shading angle=45,
               anchor=north,
               minimum width=\paperwidth, minimum height=\paperheight]
               (box) at (current page.north) {};
        \node [opacity=0.5, anchor=north, yshift=\unam@titlelogoshift] at (current page.north)
            {\unam@titlelogo};
    \end{tikzpicture}
}

\defbeamertemplate{background}{unamslide}{
    \begin{tikzpicture}[remember picture, overlay]
        \node [opacity=0.01] at (current page.center) {\unam@slidelogo};
    \end{tikzpicture}
}

