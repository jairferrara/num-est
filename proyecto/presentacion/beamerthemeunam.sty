% <<< itemize

% FIXME: figure out how to ensure that the bullets are actually in the middle of
% the text line

\def\unam@itemsize{0.5ex}
\setbeamertemplate{itemize item}{
    \tikz{
        \draw[fill=UNAMGold, draw=none] (0, 0) rectangle ++(\unam@itemsize, \unam@itemsize);
        \draw[fill=UNAMGold, draw=none] (\unam@itemsize, \unam@itemsize) rectangle ++(\unam@itemsize, \unam@itemsize);
        \draw[fill=UNAMGold, draw=none] (0, 2*\unam@itemsize) rectangle ++(\unam@itemsize, \unam@itemsize);
    }
}

\def\unam@subitemsize{0.35ex}
\setbeamertemplate{itemize subitem}{
    \tikz{
        \draw[fill=white, draw=none] (0, -0.5*\unam@subitemsize) rectangle ++(0.01, 0.01);
        \draw[fill=UNAMDarkBlue, draw=none] (0, 0) rectangle ++(\unam@subitemsize, \unam@subitemsize);
        \draw[fill=UNAMDarkBlue, draw=none] (\unam@subitemsize, \unam@subitemsize) rectangle ++(\unam@subitemsize, \unam@subitemsize);
        \draw[fill=UNAMDarkBlue, draw=none] (0, 2*\unam@subitemsize) rectangle ++(\unam@subitemsize, \unam@subitemsize);
    }
}

\setbeamertemplate{itemize subsubitem}{
    \tikz{
        \draw[fill=white, draw=none] (0, -0.5*\unam@subitemsize) rectangle ++(0.01, 0.01);
        \draw[fill=white, draw=none] (0, 0) rectangle ++(\unam@subitemsize, \unam@subitemsize);
        \draw[fill=UNAMLightBlue, draw=none] (\unam@subitemsize, \unam@subitemsize) rectangle ++(\unam@subitemsize, \unam@subitemsize);
        \draw[fill=white, draw=none] (0, 2*\unam@subitemsize) rectangle ++(\unam@subitemsize, \unam@subitemsize);
    }
}

% >>>

% <<< blocks

% Bloque: barra de color a la izquierda y fondo gris claro.
% El contenido se compone primero en una caja (lrbox + minipage) y luego se dibuja
% con su alto y su profundidad reales, así que fracciones, \displaystyle, listas o
% ecuaciones nunca se salen del fondo. El ancho es exactamente \linewidth (sin
% reescalar), el contenido queda centrado verticalmente con el mismo margen arriba y
% abajo, y si el título está vacío no se deja ninguna línea extra.
\newsavebox\unam@blockbox
\newlength\unam@blockpad   \setlength\unam@blockpad{6pt}
\newlength\unam@blockbar   \setlength\unam@blockbar{4pt}
\newcommand\unam@blockbegin[2]{%
    \def\unam@blockrule{#1}%
    \par\vskip0.4ex\noindent
    \begin{lrbox}{\unam@blockbox}%
    \begin{minipage}{\dimexpr\linewidth-\unam@blockbar-2\unam@blockpad\relax}%
        \ifx\insertblocktitle\@empty\else
            {\usebeamercolor[fg]{#2}\usebeamerfont*{block title}\insertblocktitle\par}\vskip0.4ex
        \fi
        \usebeamerfont*{block text}%
}
\newcommand\unam@blockend{%
    \end{minipage}\end{lrbox}%
    {\color{\unam@blockrule}\vrule width \unam@blockbar
        height \dimexpr\ht\unam@blockbox+\unam@blockpad\relax
        depth  \dimexpr\dp\unam@blockbox+\unam@blockpad\relax}%
    {\setlength\fboxsep{\unam@blockpad}\colorbox[gray]{0.97}{\usebox\unam@blockbox}}%
    \par\vskip0.4ex
}

\setbeamertemplate{block begin}{\unam@blockbegin{UNAMDarkBlue}{block title}}
\setbeamertemplate{block end}{\unam@blockend}
\setbeamertemplate{block alerted begin}{\unam@blockbegin{UNAMGold}{alerted text}}
\setbeamertemplate{block alerted end}{\unam@blockend}
\setbeamertemplate{block example begin}{\unam@blockbegin{UNAMLightBlue}{example text}}
\setbeamertemplate{block example end}{\unam@blockend}

